{
    "workflows": [
        {
            "name": "Test Workflow Display Name",
            "workflow_id": "root-menu",
            "initial_state": "menu",
            "render": [
                { }
            ],
            "states": [
                {
                    "name": "Test Workflow menu",
                    "state_id": "menu",
                    "display_data": [
                        {
                            "type": "image",
                            "url": "http://image.com/image.png"
                        },
                        {
                            "type": "text",
                            "display": "title",
                            "text": "This is the test for workflow, with a comma"
                        },
                        {
                            "type": "text",
                            "text": "First time showing this page",
                            "condition": "instance?.state_data?.first==undefined"
                        },
                        {
                            "type": "button",
                            "label": "Next button",
                            "action_id": "nextButton"
                        },
                        {
                            "type": "button",
                            "label": "Data button",
                            "action_id": "dataButton"
                        },
                        {
                            "type": "button",
                            "label": "Workflow button",
                            "action_id": "workflowButton"
                        }
                    ],
                    "actions": [
                        {
                            "action_id": "nextButton",
                            "type": "saveData",
                            "condition": "true",
                            "value": {"first": true }
                        }                        
                    ],
                    "transitions": [
                        {
                            "transition_id": "nextButton",
                            "type": "stateTransition",
                            "state_id": "page1",
                            "workflow_id": "",
                            "condition": "actionInput.actionID=='nextButton'"
                        },
                        {
                            "transition_id": "dataButton",
                            "type": "stateTransition",
                            "state_id": "page2",
                            "workflow_id": "",
                            "condition": "actionInput.actionID=='dataButton'"
                        }
                    ]
                },
                {
                    "name": "Test Workflow page 1",
                    "state_id": "page1",
                    "display_data": [
                        {
                            "type": "text",
                            "text": "This is the page for testing state transitions."
                        },
                        {
                            "type": "button",
                            "label": "Go back",
                            "action_id": "backButton"
                        }
                    ],
                    "actions": [
                    ],
                    "transitions": [
                        {
                            "transition_id": "backButton",
                            "type": "stateTransition",
                            "state_id": "menu",
                            "workflow_id": "",
                            "condition": "actionInput.actionID=='backButton'"
                        }
                    ]
                },
                {
                    "name": "Test Workflow page 2 data test",
                    "state_id": "page2",
                    "display_data": [
                        {
                            "type": "text",
                            "display": "title",
                            "text": "This is the page for testing data."
                        },
                        {
                            "type": "text",
                            "text": "Date={Date}",
                            "condition": "instance?.state_data?.Date!=undefined"
                        },
                        {
                            "type": "extended",
                            "text": "Extended text"
                        },
                        {
                            "type": "button",
                            "label": "Save Data",
                            "action_id": "saveButton"
                        },
                        {
                            "type": "button",
                            "label": "State Data",
                            "action_id": "stateButton"
                        },
                        {
                            "type": "button",
                            "label": "Extension",
                            "action_id": "extensionButton"
                        },
                        {
                        "form": "Test Form",
                        "type": "multiple-choice",
                        "question": "This is the question title {Date}",
                        "form-id": "question",
                        "answers": [
                                {"option": "a. {Date} to get to the other side", "value": "A" },
                                {"option": "{Date}", "value": "B"},
                                {"option": "c. better view of the mountains", "value": "{Date}"}
                            ]
                        },
                        {
                            "type": "bar-chart",
                            "title": "Lunch survey results {Date}",
                            "bars": [
                                {"label": "{Date}", "count": "{Date}" },
                                {"label": "French cafe", "count": "14"},
                                {"label": "Pizza parlour", "count": "72"}
                            ]
                        },
                        {
                            "type": "donut-chart",
                            "title": "Lunch survey {Date} results",
                            "slices": [
                                {"label": "Chicken restaurant", "count": "53"},
                                {"label": "{Date} cafe", "count": "14"},
                                {"label": "Pizza parlour", "count": "{Date}"}
                            ]
                        },
                        {
                            "type": "basic-table",
                            "title": "Menu {Date}",
                            "border": true,
                            "header": [
                                {"column1": "Name {Date}", "order": "1" },
                                {"column1": "Description", "order": "2" },
                                {"column1": "Price", "order": "3" }
                            ],
                            "rows": [
                                {"column1": "Salad", "column2": "Lettuce and tomato", "column3": "$5.99"},
                                {"column1": "Meat {Date}", "column2": "Ham {Date}", "column3": "$15.99"},
                                {"column1": "Cake", "column2": "Chocolate", "column3": "{Date}"}
                            ]
                        },
                        {
                            "type": "gauge",
                            "title": "Progress {Date}",
                            "value": "{Date}",
                            "min": "{Date}",
                            "max": "{Date}"
                        },
                        {
                            "type": "card",
                            "title": "Special {Date}",
                            "text": "This is the text that appears in a card {Date}."
                        },
                        {
                            "type": "timeline",
                            "title": "Roadmap to the {Date} future",
                            "entries": [
                                {"order": "1", "entry": "Day 1 {Date} ", "text": "Write a {Date} list"},
                                {"order": "2", "entry": "{Date}", "text": "{Date}"},
                                {"order": "3", "entry": "Year 2", "text": "Check off the tasks"},
                                {"order": "4", "entry": "Year 3", "text": "Bask in glory"}
                            ]
                        },
                        {
                            "form": "Save Form",
                            "type": "text-field",
                            "label": "Field one",
                            "value": "{save-field}",
                            "form-id": "save-field"
                        },                        
                        {
                            "form": "Save Form",
                            "type": "text-field",
                            "label": "Field two",
                            "value": "{Date}",
                            "form-id": "save-field2"
                        },                        
                        {
                            "type": "button",
                            "label": "Go back",
                            "action_id": "backButton"
                        }
                    ],
                    "actions": [
                        {
                            "action_id": "stateButton",
                            "type": "stateData",
                            "condition": "true",
                            "value": "action.data"
                        },
                        {
                            "action_id": "extensionButton",
                            "type": "extension",
                            "condition": "true",
                            "value": {"extended": true }
                        },
                        {
                            "action_id": "saveButton",
                            "type": "saveData",
                            "condition": "true",
                            "value": {"data": "Hello"}
                        }
                    ],
                    "transitions": [
                        {
                            "transition_id": "backButton",
                            "type": "stateTransition",
                            "state_id": "menu",
                            "workflow_id": "",
                            "condition": "actionInput.actionID=='backButton'"
                        }
                    ]
                }
            ]
        },
        {
            "name": "Test Other Workflow ",
            "workflow_id": "other-menu",
            "initial_state": "menu2",
            "render": [
                { }
            ],
            "states": [
                {
                    "name": "Test Other Workflow menu",
                    "state_id": "menu2",
                    "display_data": [
                        {
                            "type": "title",
                            "text": "This is the other test workflow."
                        },
                        {
                            "type": "button",
                            "label": "Go home workflow",
                            "action_id": "homeButton"
                        },
                        {
                            "type": "button",
                            "label": "No action button",
                            "action_id": "noactionButton"
                        }

                    ],
                    "actions": [
                        {
                            "action_id": "homeButton",
                            "type": "workflowTransition",
                            "condition": "true",
                            "value": "root-menu"
                        }
                    ],
                    "transitions": [
                        {
                            "transition_id": "homeButton",
                            "type": "workflowTransition",
                            "state_id": "",
                            "workflow_id": "root-menu",
                            "condition": "actionInput.actionID=='homeButton'"
                        },
                        {
                            "transition_id": "noactionButton",
                            "type": "workflowTransition",
                            "state_id": "",
                            "workflow_id": "root-menu",
                            "condition": "actionInput.actionID=='noactionButton'"
                        }
                    ]
                }
            ]
        }
    ]
}